          "response": [
            {
              "name": "201 Created",
              "originalRequest": {},
              "status": "Created",
              "code": 201,
              "_postman_previewlanguage": "json",
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": "{\n  \"message\": \"User registered successfully\",\n  \"refresh\": \"<refresh_token>\",\n  \"access\": \"<access_token>\",\n  \"access_expires_at\": \"2026-01-31T12:00:00+00:00\",\n  \"refresh_expires_at\": \"2026-03-01T12:00:00+00:00\",\n  \"access_expires_in\": 86400,\n  \"refresh_expires_in\": 2592000,\n  \"user\": {\n    \"id\": 1,\n    \"email\": \"user@example.com\",\n    \"full_name\": \"John Doe\",\n    \"phone\": \"201234567890\",\n    \"role\": \"customer\",\n    \"profile_image\": null,\n    \"is_active\": true,\n    \"created_at\": \"2026-01-31T11:00:00Z\",\n    \"updated_at\": \"2026-01-31T11:00:00Z\"\n  }\n}"
            },
            {
              "name": "400 Validation error",
              "originalRequest": {},
              "status": "Bad Request",
              "code": 400,
              "_postman_previewlanguage": "json",
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": "{\n  \"email\": [\"A user with this email already exists.\"]\n}"
            }
          ]
        },
        {
          "name": "Login (POST /api/auth/login/)",
          "request": {
            "method": "POST",
            "header": [
