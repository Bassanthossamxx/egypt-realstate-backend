              "code": 401,
              "_postman_previewlanguage": "json",
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": "{\n  \"detail\": \"No active account found with the given credentials\"\n}"
            }
          ]
        },
        {
          "name": "Refresh token (POST /api/auth/refresh/)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refresh\": \"{{refreshToken}}\"\n}"
            },
            "url": {
              "raw": "{{baseurl}}/api/auth/refresh/",
              "host": ["{{baseurl}}"],
              "path": ["api", "auth", "refresh", ""]
            },
            "description": "Exchange refresh token for a new access token (and possibly a rotated refresh token)."
          },
          "response": [
            {
              "name": "200 OK (rotation may return refresh)",
              "originalRequest": {},
              "status": "OK",
              "code": 200,
              "_postman_previewlanguage": "json",
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": "{\n  \"access\": \"<new_access_token>\",\n  \"refresh\": \"<new_refresh_token>\"\n}"
            },
            {
              "name": "401 Token not valid",
              "originalRequest": {},
              "status": "Unauthorized",
              "code": 401,
              "_postman_previewlanguage": "json",
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": "{\n  \"detail\": \"Token is invalid or expired\",\n  \"code\": \"token_not_valid\"\n}"
