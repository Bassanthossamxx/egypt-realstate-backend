            "body": {
              "mode": "raw",
              "raw": "{\n  \"refresh\": \"{{refreshToken}}\"\n}"
            },
            "url": {
              "raw": "{{baseurl}}/api/auth/logout/",
              "host": ["{{baseurl}}"],
              "path": ["api", "auth", "logout", ""]
            },
            "description": "Blacklist the refresh token (requires a valid access token)."
          },
          "response": [
            {
              "name": "205 Reset Content",
              "originalRequest": {},
              "status": "Reset Content",
              "code": 205,
